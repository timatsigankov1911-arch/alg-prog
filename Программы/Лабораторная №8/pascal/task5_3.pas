program Task_5_3;
{ Процедура: Test
  Назначение: показывает локальную переменную
  Формальные параметры: нет
  Локальные переменные: x
  Глобальные переменные: нет
  Изменяет: ничего (выводит x на экран)
}
procedure Test;
var
  x: integer;
begin
  x := 42;
  writeln('Внутри Test: x = ', x);
end;
begin
  Test;
  writeln('Снаружи переменная x недоступна');
end.